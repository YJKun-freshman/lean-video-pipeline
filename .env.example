# 複製這個檔案為 .env，並填入自己的 key
# .env 已列在 .gitignore，不會被推上 GitHub

# Google Gemini API（逐字稿改寫用，AI Studio 申請，免信用卡真免費）
# 申請位置：https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# 要處理的 YouTube 影片網址
SOURCE_VIDEO_URL=https://www.youtube.com/watch?v=KjAI9r8tnOs

# 成本控制參數
MAX_AUDIO_MINUTES=15
MAX_SEGMENTS_TO_GENERATE=3
WHISPER_MODEL_SIZE=base
GEMINI_MODEL=gemini-3.5-flash-lite